{
  "name": "ai-storefront",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:types": "node scripts/db-types.mjs",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.tests.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "npm run typecheck && vitest run",
    "check": "npm run typecheck && npm run lint && vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:llm": "playwright test --config playwright.llm.config.ts",
    "test:llm": "vitest run --config vitest.llm.config.ts"
  },
  "dependencies": {
    "@nuxt/image": "^2.1.0",
    "@pinia/nuxt": "^1.0.2",
    "@primeuix/themes": "^1.2.5",
    "@primevue/nuxt-module": "^4.5.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.3.3",
    "nuxt": "^4.5.2",
    "openai": "^7.9.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeicons": "^8.0.0",
    "primevue": "^4.5.5",
    "resend": "^6.25.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "supabase": "^2.117.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
