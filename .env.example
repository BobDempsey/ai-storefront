# Supabase — service role key is server-only, never expose it to the browser
NUXT_SUPABASE_URL=https://your-project.supabase.co
NUXT_SUPABASE_SERVICE_KEY=your-service-role-key

# Resend
NUXT_RESEND_API_KEY=re_xxxxxxxx
NUXT_ORDER_FROM_EMAIL=onboarding@resend.dev
NUXT_ORDER_ADMIN_EMAIL=you@example.com

# Promo codes are rows in the promo_codes table, not an env var. Staff add and
# deactivate them in the Supabase dashboard; the welcome email sends whichever
# one is active.

# Public — safe to ship to the browser. Contact messages go to
# NUXT_ORDER_ADMIN_EMAIL via the /contact form, so no address is public.
NUXT_PUBLIC_STORE_NAME=Store
# Your public origin, no trailing slash. Link previews need an absolute image
# URL, so leaving this unset ships share tags with no picture.
NUXT_PUBLIC_SITE_URL=https://example.com
# This shop's share image, a path under public/ with a leading slash. It is set
# per deployment because the image has the shop's name drawn into it and one
# build serves more than one shop; leaving it unset ships share tags with no
# picture, which beats a preview carrying another shop's name. Render one with
#   node scripts/og-image.mjs --name "Your Shop" --domain your.example.com \
#     --out public/og-image-your-shop.png
NUXT_PUBLIC_OG_IMAGE=/og-image.png
# Optional. Names a deployment that is not the live shop, so a banner and the
# tab title say so. Leave it unset in production. Set it to "preview" on a
# preview deployment; a dev server marks itself without it.
# NUXT_PUBLIC_DEPLOY_ENV=preview

# OpenAI — powers the shopping assistant. Server-only; the drawer reports the
# assistant as unavailable while this is a placeholder.
NUXT_OPENAI_API_KEY=sk-xxxxxxxx

# Supabase personal access token, scoped to this project and read-only. Needed
# only to regenerate the Database types; nothing at build or run time reads it.
SUPABASE_ACCESS_TOKEN=

# Pexels — free key from https://www.pexels.com/api/. Needed only to fetch
# product photographs into public/images/; nothing at build or run time reads it.
PEXELS_API_KEY=

# Test orders — server-only. A request may mark an order as a test, and so skip
# the staff notification, only by sending this value in an x-test-order-token
# header. Leave it blank in production and no request can mark anything.
NUXT_TEST_ORDER_TOKEN=

# Which request header the rate limiter trusts to name the caller. A header the
# client can set is not an identity, so only the one named here is read.
#   Vercel          x-vercel-forwarded-for   (the default; Vercel sets it)
#   nginx, Caddy    x-forwarded-for          (only if YOUR proxy sets it)
#   Cloudflare      cf-connecting-ip
#   bare Node       leave empty to use the connection address
NUXT_TRUSTED_IP_HEADER=x-vercel-forwarded-for
