# Supabase — service role key is server-only, never expose it to the browser
NUXT_SUPABASE_URL=https://your-project.supabase.co
NUXT_SUPABASE_SERVICE_KEY=your-service-role-key

# Resend
NUXT_RESEND_API_KEY=re_xxxxxxxx
NUXT_ORDER_FROM_EMAIL=onboarding@resend.dev
NUXT_ORDER_ADMIN_EMAIL=you@example.com

# Public — rendered into the page as a mailto link. Leave blank to hide the
# contact icon in the navbar.
NUXT_PUBLIC_STORE_NAME=Store
NUXT_PUBLIC_CONTACT_EMAIL=hello@example.com
